#!/usr/bin/env python

"""
This is a program for validating GeneLab pipeline processed metagenomics datasets.
GL-validate-processed-metagenomics-data --glds-id "OSD-944" --runsheet processing_info/PE_file.csv --assay-suffix ''  --technology illumina --sample-type low_biomass --outdir . --processing-zip-file Post_Processing/processing_info.zip
It performs explicit validation for all expected files, structures, and sample content matches across:
1. Illumina Low Biomass (_GLlbsMetag)
2. Illumina Standard (_GLmetagenomics)
3. Nanopore Low Biomass (_GLlblMetag)
4. Nanopore Standard (_GLlongMetag)
"""

import json
import os
import sys
import argparse
import textwrap
import pandas as pd
import zipfile
from statistics import mean, median
from pathlib import Path

parser = argparse.ArgumentParser(description = "This program validates a GeneLab pipeline processed metagenomics dataset.")
required = parser.add_argument_group('required arguments')

required.add_argument("--glds-id", "--osd-id", help='GLDS or OSDR ID (e.g. "OSD-944")', action="store", required=True)
required.add_argument("-s", "--runsheet", help = "Run sheet CSV file with sample names in the first column", action = "store", required = True)
required.add_argument("--outdir", help="Directory of generated output files to be validated.", action="store", required=True)
parser.add_argument("--output", help = 'Name of output log file (default: "<GLDS-ID>_<output_prefix>metagenomics-validation.log")', default = "", action = "store")
parser.add_argument("--manifest", help = 'Name of output structural JSON manifest (default: "<GLDS-ID>_<output_prefix>metagenomics-validation.manifest.json")', default = "", action = "store")
parser.add_argument("-p", "--output-prefix", help = "Output additional file prefix if there is one", action = "store", default = "")
parser.add_argument("-l", "--v-v-guidelines-link", help = "Validation and verification guidelines link", action = "store", 
                    default = "https://genelab-tools.arc.nasa.gov/confluence/pages/viewpage.action?pageId=8225175")
parser.add_argument('--assay-suffix', default='_GLmetagenomics', help="GeneLab assay suffix. One of '_GLmetagenomics', '_GLlbsMetag', '_GLlblMetag', and '_GLlongMetag'")
parser.add_argument("--raw-suffix", help = "Raw reads suffix for datasets", action = "store", default ="_HRrm.fastq.gz")
parser.add_argument("--raw-R1-suffix", help = "Raw forward reads suffix for illumina datasets", action = "store", default = "_R1_HRrm.fastq.gz")
parser.add_argument("--raw-R2-suffix", help = "Raw reverse reads suffix for illumina datasets", action = "store", default = "_R2_HRrm.fastq.gz")
parser.add_argument("--filtered-suffix", help = "Filtered reads suffix", action = "store", default = "_filtered.fastq.gz")
parser.add_argument("--filtered-R1-suffix", help = "Filtered forward reads suffix for illumina datasets", action = "store", default = "_R1_filtered.fastq.gz")
parser.add_argument("--filtered-R2-suffix", help = "Filtered reverse reads suffix for illumina datasets", action = "store", default = "_R2_filtered.fastq.gz")
parser.add_argument("--trimmed-suffix", help = "Trimmed reads suffix for nanopore datasets", action = "store", default = "_trimmed.fastq.gz")
parser.add_argument("--decontam-suffix", help = "Decontaminated reads suffix", action = "store", default = "_decontam.fastq.gz")
parser.add_argument("--decontam-R1-suffix", help = "Decontaminated forward reads suffix for illumina datasets", action = "store", default = "_R1_decontam.fastq.gz")
parser.add_argument("--decontam-R2-suffix", help = "Decontaminated reverse reads suffix for illumina datasets", action = "store", default = "_R2_decontam.fastq.gz")
parser.add_argument("--human-suffix", help = "Human removed reads suffix", action = "store", default = "_HRrm.fastq.gz")
parser.add_argument("--host-suffix", help = "Host removed reads suffix", action = "store", default = "_HostRm.fastq.gz")
parser.add_argument("--host-R1-suffix", help = "Host removed forward reads suffix for illumina datasets", action = "store", default = "_R1_HostRm.fastq.gz")
parser.add_argument("--host-R2-suffix", help = "Host removed reverse reads suffix for illumina datasets", action = "store", default = "_R2_HostRm.fastq.gz")
parser.add_argument("--technology", default="illumina", choices=["illumina", "nanopore"], action="store")
parser.add_argument("--sample-type", default="standard", choices=["low_biomass", "standard"], action="store")
parser.add_argument("--host-removed", default=False, action="store_true", help='Indicates if host sequences were removed from the dataset')
parser.add_argument("--processing-zip-file", help = "Specifies the location of processing_info.zip", action = "store", default = "processing_info.zip")
parser.add_argument("--single-ended", help = "Add this flag if illumina data are single-end sequencing.", action = "store_true")

if len(sys.argv) == 1:
    parser.print_help(sys.stderr)
    sys.exit(0)

args = parser.parse_args()

# Global dictionary tracking verified and unverified paths for structural reporting
manifest_data = {
    "verified": [],
    "missing_optional": [],
    "failed_missing": [],
    "failed_empty": [],
    "failed_assemblies": []
}

# Setting some colors
tty_colors = {
    'green' : '\033[0;32m%s\033[0m',
    'yellow' : '\033[0;33m%s\033[0m',
    'red' : '\033[0;31m%s\033[0m'
}

def color_text(text, color='green'):
    if sys.stdout.isatty():
        return tty_colors[color] % text
    return text

def wprint(text):
    """ Print wrapper """
    print(textwrap.fill(text, width = 120, initial_indent="  ", subsequent_indent="  ", break_on_hyphens=False))

def write_manifest_to_disk(manifest_path):
    """ Exports the structured JSON overview tracking results """
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest_data, f, indent=4)

def report_failure(validation_log, message, color = "yellow", write_log = True, missing_file = None, failure_type = "missing"):
    print("")
    wprint(color_text(message, color))
    if missing_file and missing_file not in manifest_data["failed_missing"] and missing_file not in manifest_data["failed_empty"]:
        if failure_type == "empty":
            manifest_data["failed_empty"].append(str(missing_file))
        else:
            manifest_data["failed_missing"].append(str(missing_file))
        
    if write_log:
        with open(validation_log, "a") as log:
            log.write(f"{message}\n")

def report_no_exist(validation_log, message, color = "yellow", write_log = True, optional_file = None):
    """ Reports that an expected file was not found, but does not fail validation since some files may be conditionally expected """
    print("")
    wprint(color_text(message, color))
    if optional_file and optional_file not in manifest_data["missing_optional"]:
        manifest_data["missing_optional"].append(str(optional_file))
    if write_log:
        with open(validation_log, "a") as log:
            log.write(f"{message}.\n\n")

def is_optional_file(file_path):
    """ Evaluates whether a file is structurally optional (e.g. top 50 heatmap metrics, filtered, bins, or MAGs) """
    norm_path = str(file_path).lower()
    if "top_50" in norm_path:
        return True
    if ("filtered" in norm_path and 'fastq' not in norm_path) and ("multiqc" not in norm_path) and ("unfiltered" not in norm_path):
        return True
    if "assembly-based_processing/bins" in norm_path or "assembly-based_processing/mags" in norm_path:
        return True
    return False

def modify_symbolic_link(file_path):
    """ Modify symbolic link such that it returns a string containing the parent dir and the base name"""
    full_path = os.path.realpath(file_path)
    parent_dir = os.path.basename(os.path.dirname(full_path))
    base_name = os.path.basename(full_path)
    return Path(parent_dir, base_name)

def setup_log(validation_log, V_V_guidelines_link):
    """ Writes validation log's header """
    with open(validation_log, "w") as log:
        log.write(f"Performing baseline Metagenomics V+V as per: {V_V_guidelines_link}\n\n")
        command_run = " ".join(sys.argv)
        log.write(f"Validation program executed as:\n    {command_run}\n\n")

def append_message_to_log(validation_log, message):
    """ Appends line to validation log """
    with open(validation_log, "a") as log:
        log.write(f"{message}\n")

def check_for_file_and_contents(validation_log, file_path: Path):
    """ Checks if a file exists and that it is not empty """
    is_opt = is_optional_file(file_path)

    # Check for optional decontamination file (fastq files are not optional, only feature decontamination output is optional)
    if not file_path.exists() and 'decontam' in file_path.name and '.fastq' not in file_path.suffixes:
        report_no_exist(validation_log, f"The expected decontamination file '{file_path}' does not exist. This maybe because decontamination with decontam failed. Please check!", optional_file=file_path)
        return
    
    if not file_path.exists():
        # Check for other optional files
        if is_opt:
            report_no_exist(validation_log, f"The optional file '{file_path}' does not exist.", optional_file=file_path)
            return
        else:
            report_failure(validation_log, f"The expected file '{file_path}' does not exist.", missing_file=file_path, failure_type="missing")
            return

    if not file_path.stat().st_size > 0:
        report_failure(validation_log, f"The file '{file_path}' is empty.", missing_file=file_path, failure_type="empty")
        return
        
    if file_path not in manifest_data["verified"]:
        manifest_data["verified"].append(str(file_path))

def check_expected_directories(validation_log, expected_dirs, optional_dirs=None):
    """ Checks that the expected directories exist """
    for directory in expected_dirs:
        if not os.path.isdir(directory):
            report_failure(validation_log, f"The directory '{directory}' was expected but not found.", missing_file=directory, failure_type="missing")
    
    if optional_dirs:
        for directory in optional_dirs:
            if not os.path.isdir(directory):
                report_no_exist(validation_log, f"The optional directory '{directory}' is missing.", optional_file=directory)

def read_samples(file_path):
    """ Gets sample names from runsheet (skipping header row) """
    sample_names = set()
    with open(file_path) as f:
        next(f)  # skip header line
        for line in f:
            name = line.strip().split(",")[0]
            if name:
                sample_names.add(name)
    return list(sample_names)

def find_multiqc_json_from_zip(zf):
    """ Safely extracts path to multiqc_data.json within MultiQC zip archive """
    for name in zf.namelist():
        if os.path.basename(name) == "multiqc_data.json":
            return name
    return None

def load_json_from_path(path):
    """ Parses MultiQC json dictionary directly out of zipped outputs """
    try:
        with zipfile.ZipFile(path, "r") as zf:
            name = find_multiqc_json_from_zip(zf)
            if not name:
                raise FileNotFoundError("No multiqc_data.json found in zip")
            with zf.open(name) as fh:
                return json.load(fh)
    except zipfile.BadZipFile as exc:
        raise RuntimeError(f"Invalid zip file: {path}") from exc

def get_multiqc_samples(zip_file, technology):
    """ Pulls unique sample signature keys depending on long/short read layout keys """
    data = load_json_from_path(zip_file)
    if technology == "nanopore":
        reads_stats = data.get("report_saved_raw_data", {}).get("multiqc_nanostat", {})
    else:
        reads_stats = data.get("report_general_stats_data", [{}])[0]
    return list(reads_stats.keys())

def check_multiqc_outputs(validation_log, technology, sample_names, multiqc_zip, multiqc_type_prefix,
                          R1_suffix, R2_suffix, unpaired_suffix, isSingle_ended):
    """ Verifies all samples are indexed correctly within MultiQC JSON metrics records """
    check_for_file_and_contents(validation_log, multiqc_zip)
    file_prefixes_in_multiqc = get_multiqc_samples(multiqc_zip, technology)
    
    if technology == "illumina":
        if not isSingle_ended:
            R1_sub = R1_suffix.split(".")[0].replace(f"_{multiqc_type_prefix}", "")
            R2_sub = R2_suffix.split(".")[0].replace(f"_{multiqc_type_prefix}", "")
            for sample in sample_names:
                if not f"{sample}{R1_sub}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {multiqc_type_prefix} multiqc output is missing expected '{sample}{R1_sub}' entry.")
                if not f"{sample}{R2_sub}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {multiqc_type_prefix} multiqc output is missing expected '{sample}{R2_sub}' entry.")
        else:
            sub = unpaired_suffix.split(".")[0].replace(f"_{multiqc_type_prefix}", "")
            for sample in sample_names:
                if not f"{sample}{sub}" in file_prefixes_in_multiqc and not f"{sample}" in file_prefixes_in_multiqc:
                    report_failure(validation_log, f"The {multiqc_type_prefix} multiqc output is missing expected '{sample}{sub}' entry.")
    else:
        for sample in sample_names:
            if not f"{sample}" in file_prefixes_in_multiqc:
                report_failure(validation_log, f"The {multiqc_type_prefix} multiqc output is missing expected '{sample}' entry.")

def check_nanoplot_outputs(validation_log, sample_names, nanoplot_dir, nanoplot_type_prefix, output_prefix, assay_suffix):
    """ Explicit check loop verifying every NanoPlot sample report.html is non-empty and accessible """
    for sample in sample_names:
        nanoplot_html_path = Path(nanoplot_dir, f"{output_prefix}{sample}_{nanoplot_type_prefix}_NanoPlot-report{assay_suffix}.html")
        check_for_file_and_contents(validation_log, nanoplot_html_path)

def check_fastq_files(validation_log, technology, sample_names, reads_dir, 
                      unpaired_suffix, R1_suffix="", R2_suffix="", isSingle_ended=True, output_prefix=""):
    """ Explicit check loop verifying every fastq sample bundle is non-empty and accessible """
    for sample in sample_names:
        if technology == "illumina":
            if not isSingle_ended:
                check_for_file_and_contents(validation_log, Path(reads_dir, f"{output_prefix}{sample}{R1_suffix}"))
                check_for_file_and_contents(validation_log, Path(reads_dir, f"{output_prefix}{sample}{R2_suffix}"))
            else:
                check_for_file_and_contents(validation_log, Path(reads_dir, f"{output_prefix}{sample}{unpaired_suffix}"))
        else:
            check_for_file_and_contents(validation_log, Path(reads_dir, f"{output_prefix}{sample}{unpaired_suffix}"))

def check_plots_for_samples(validation_log, sample_names, plot_path):
    """ Checks text & binary image encodings for unique sample keywords to guarantee plot completeness """
    if not os.path.exists(plot_path) and 'decontam' in plot_path.name:
        report_no_exist(validation_log, f"The expected decontamination plot '{plot_path}' does not exist.", optional_file=plot_path)
        return
        
    is_opt = is_optional_file(plot_path)
    if not os.path.exists(plot_path):
        if is_opt:
            report_no_exist(validation_log, f"Optional plot '{plot_path}' does not exist.", optional_file=plot_path)
            return
        else:
            report_failure(validation_log, f"The expected plot '{plot_path}' does not exist.", missing_file=plot_path)
            return

    check_for_file_and_contents(validation_log, plot_path)
    
    if plot_path.suffix == '.html':
        with open(plot_path, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        for sample in sample_names:
            if sample not in content:
                report_no_exist(validation_log, f"Plot structure integrity audit failed: Sample '{sample}' was missing in interactive asset '{plot_path}'.", optional_file=f"{plot_path}::sample:{sample}")
    elif plot_path.suffix == '.png':
        with open(plot_path, 'rb') as f:
            content_bytes = f.read()
        for sample in sample_names:
            if sample.encode('utf-8', errors='ignore') not in content_bytes:
                pass
                #report_no_exist(validation_log, f"Plot structure integrity audit failed: Sample '{sample}' was missing in static png asset '{plot_path}'.", optional_file=f"{plot_path}::sample:{sample}")

def get_files_in_dir(dir_path):
    if not os.path.exists(dir_path): return []
    return [f for f in os.listdir(dir_path) if os.path.isfile(Path(dir_path, f))]

def check_read_based_outputs(validation_log, filenames, read_based_dir):
    """ Assures globally combined read-based tables are intact """
    for file in filenames:
        check_for_file_and_contents(validation_log, Path(read_based_dir, file))

def check_general_fasta_format(validation_log, file_path):
    """ Explicitly audits header alignment with structural fasta properties """
    if not os.path.getsize(file_path) > 0:
        report_failure(validation_log, f"The fasta file '{file_path}' is empty but isn't expected to be.", missing_file=file_path)
    line_num, num_headers, num_seqs = 0, 0, 0
    with open(file_path) as in_file:
        for line in in_file:
            line_num += 1
            if line.strip().startswith(">"):
                num_headers += 1
            else:
                num_seqs += 1
            if num_headers != num_seqs + 1 and num_headers != num_seqs:
                report_failure(validation_log, f"Fasta file '{file_path}' format break down detected at line {line_num}.", missing_file=file_path)

def get_failed_assemblies(failed_assemblies):
    failed_assemblies_list = []
    if failed_assemblies.exists():
        manifest_data["verified"].append(str(failed_assemblies))
        with open(failed_assemblies) as failed:
            for line in failed:
                sample = line.strip().split("\t")[0]
                failed_assemblies_list.append(sample)
                manifest_data["failed_assemblies"].append(sample)
    return failed_assemblies_list

def check_assembly_based_file(validation_log, sample, file_path, failed_assemblies_list, assembly = True):
    if os.path.exists(file_path):
        if os.path.getsize(file_path) == 0:
            if sample not in failed_assemblies_list and assembly == True:
                report_failure(validation_log, f"The file '{file_path}' is empty, but sample is not in Failed-assemblies tracking logs.", missing_file=file_path)
    else:
        report_failure(validation_log, f"The expected file '{file_path}' does not exist.", missing_file=file_path)

def check_assembly_based_genes_file(validation_log, sample, file_path, failed_assemblies_list):
    if os.path.exists(file_path) and sample not in failed_assemblies_list:
        if not os.path.getsize(file_path) > 0:
            report_failure(validation_log, f"The expected gene architecture file '{file_path}' exists, but appears to be empty.", missing_file=file_path)

def check_assemblies(validation_log, sample_names, failed_assemblies_list,
                     assembly_suffix, assemblies_dir, assembly_summary, output_prefix=""):
    for sample in sample_names:
        curr_fasta_path = Path(assemblies_dir, f"{output_prefix}{sample}{assembly_suffix}")
        if sample not in failed_assemblies_list:
            check_assembly_based_file(validation_log, sample, curr_fasta_path, failed_assemblies_list)
            check_general_fasta_format(validation_log, curr_fasta_path)
            if curr_fasta_path not in manifest_data["verified"]:
                manifest_data["verified"].append(str(curr_fasta_path))
    
    assembly_summary_path = Path(assemblies_dir, assembly_summary)
    check_for_file_and_contents(validation_log, assembly_summary_path)

def check_genes(validation_log, sample_names, failed_assemblies_list, genes_dir,
                 predicted_gene_file_suffixes, gene_fasta_suffixes, output_prefix=""):
    for sample in sample_names:
        if sample not in failed_assemblies_list:
            for suffix in predicted_gene_file_suffixes:
                curr_file_path = Path(genes_dir, f"{output_prefix}{sample}{suffix}")
                check_assembly_based_genes_file(validation_log, sample, curr_file_path, failed_assemblies_list)
                if os.path.exists(curr_file_path) and os.path.getsize(curr_file_path) > 0:
                    if curr_file_path not in manifest_data["verified"]:
                        manifest_data["verified"].append(str(curr_file_path))
            for suffix in gene_fasta_suffixes:
                curr_fasta_path = Path(genes_dir, f"{output_prefix}{sample}{suffix}")
                if os.path.exists(curr_fasta_path) and os.path.getsize(curr_fasta_path) > 0:
                    check_general_fasta_format(validation_log, curr_fasta_path)

def check_contig_annotation(validation_log, sample_names, annotations_and_tax_dir, annotations_suffixes, output_prefix=""):
    for sample in sample_names:
        for suffix in annotations_suffixes:
            curr_file_path = Path(annotations_and_tax_dir, f"{output_prefix}{sample}{suffix}")
            check_for_file_and_contents(validation_log, curr_file_path)

def check_mapping(validation_log, sample_names, mapping_dir, failed_assemblies_list,
                  mapping_dir_suffixes_all_have, mapping_info_suffix, output_prefix=""):
    for sample in sample_names:
        for suffix in mapping_dir_suffixes_all_have:
            curr_file_path = Path(mapping_dir, f"{output_prefix}{sample}{suffix}")
            if sample not in failed_assemblies_list:
                check_assembly_based_file(validation_log, sample, curr_file_path, failed_assemblies_list)
                if os.path.exists(curr_file_path) and os.path.getsize(curr_file_path) > 0:
                    if curr_file_path not in manifest_data["verified"]:
                        manifest_data["verified"].append(str(curr_file_path))
        if sample not in failed_assemblies_list:
            curr_file_path = Path(mapping_dir, f"{output_prefix}{sample}{mapping_info_suffix}")
            check_assembly_based_file(validation_log, sample, curr_file_path, failed_assemblies_list)
            if os.path.exists(curr_file_path) and os.path.getsize(curr_file_path) > 0:
                if curr_file_path not in manifest_data["verified"]:
                    manifest_data["verified"].append(str(curr_file_path))

def check_combined_outputs(validation_log, combined_output_dir, expected_assembly_combined_outputs):
    for filename in expected_assembly_combined_outputs:
        curr_file_path = Path(combined_output_dir, filename)
        check_for_file_and_contents(validation_log, curr_file_path)

def check_bins(validation_log, bins_dir, bins_summary, output_fasta_bins):
    for bin_file in output_fasta_bins:
        curr_file_path = Path(bins_dir, bin_file)
        check_for_file_and_contents(validation_log, curr_file_path)
    if len(output_fasta_bins) > 0:
        bins_summary_path = Path(bins_dir, bins_summary)
        check_for_file_and_contents(validation_log, bins_summary_path)

def check_mags(validation_log, MAGs_dir, output_fasta_MAGs, output_fasta_bins, MAGs_summary):
    for MAG_file in output_fasta_MAGs:
        curr_file_path = Path(MAGs_dir, MAG_file)
        check_for_file_and_contents(validation_log, curr_file_path)
    if len(output_fasta_bins) > 0:
        MAGs_summary_path = Path(MAGs_dir, MAGs_summary)
        check_for_file_and_contents(validation_log, MAGs_summary_path)

def check_assembly_based_overview_table(validation_log, expected_samples, overview_table_path):
    check_for_file_and_contents(validation_log, overview_table_path)
    if not os.path.exists(overview_table_path):
        return
    overview_tab = pd.read_csv(overview_table_path, sep = "\t")
    samples_in_tab = overview_tab['Sample_ID'].tolist()
    missing_sample_IDs = [sample for sample in expected_samples if sample not in samples_in_tab]
    if missing_sample_IDs:
        report_failure(validation_log, f"The overview table '{overview_table_path}' lacks samples: {', '.join(missing_sample_IDs)}.", missing_file=overview_table_path)

def check_metagenomics_processing_zip(validation_log, processing_zip_file, expected_zip_contents):
    check_for_file_and_contents(validation_log, processing_zip_file)
    if not os.path.exists(processing_zip_file):
        return
    with zipfile.ZipFile(processing_zip_file) as zip_obj:
        entries = zip_obj.namelist()
    ROOT_DIR = entries[0]
    for item in expected_zip_contents:
        if ROOT_DIR + item not in entries:
            report_failure(validation_log, f"The '{processing_zip_file}' lacks element '{item}'.", missing_file=f"{processing_zip_file}::{item}")

def gen_stats(list_of_ints):
    return min(list_of_ints), max(list_of_ints), round(mean(list_of_ints), 2), int(median(list_of_ints))

def get_read_count_stats(validation_log, prefix, multiqc_zip, technology):
    try:
        data = load_json_from_path(multiqc_zip)
        counts = []
        if technology == "nanopore" and "report_saved_raw_data" in data:
            for sdata in data["report_saved_raw_data"].get("multiqc_nanostat", {}).values():
                if "Number of reads" in sdata:
                    counts.append(int(float(sdata["Number of reads"].replace(",", ""))))
        else:
            gen_stats_data = data.get("report_general_stats_data", [{}])[0]
            for sdata in gen_stats_data.values():
                for k, v in sdata.items():
                    if "count" in k.lower() or "reads" in k.lower():
                        counts.append(int(float(v)))
                        break
        if counts:
            Min, Max, Mean, Median = gen_stats(counts)
            print(f"\n  {prefix.title()} read count summary:\n    Min: {Min}\n    Max: {Max}\n    Mean: {Mean}\n    Median: {Median}")
            with open(validation_log, "a") as log:
                log.write(f"\n  {prefix.title()} read count summary:\n    Min: {Min}\n    Max: {Max}\n    Mean: {Mean}\n    Median: {Median}\n")
    except Exception:
        pass

def main():
    output_prefix = str(args.output_prefix)
    assay_suffix = str(args.assay_suffix)
    tech = str(args.technology)
    stype = str(args.sample_type)

    outdir = Path(args.outdir)

    manifest_data["outdir"] = args.outdir
    
    raw_dir = Path(outdir, "Merged_Sequence_Data")
    filtered_dir = Path(outdir, "Filtered_Sequence_Data")
    decontam_dir = Path(outdir, "Decontaminated_Sequence_Data")
    host_dir = Path(outdir, "HostRm-removed_Sequence_Data")
    trimmed_dir = Path(outdir, "Trimmed_Sequence_Data")
    hrrm_dir = Path(outdir, "HR-removed_Sequence_Data")
    
    read_based_dir = Path(outdir, "Read-based_Processing")
    assembly_based_dir = Path(outdir, "Assembly-based_Processing")
    
    assemblies_dir = Path(assembly_based_dir, "assemblies")
    genes_dir = Path(assembly_based_dir, "predicted-genes")
    annotations_and_tax_dir = Path(assembly_based_dir, "annotations-and-taxonomy")
    mapping_dir = Path(assembly_based_dir, "read-mapping")
    bins_dir = Path(assembly_based_dir, "bins")
    MAGs_dir = Path(assembly_based_dir, "MAGs")
    combined_output_dir = Path(assembly_based_dir, "combined-outputs")

    expected_dirs = [raw_dir, filtered_dir, read_based_dir, assembly_based_dir,
                     assemblies_dir, genes_dir, annotations_and_tax_dir, mapping_dir,
                     combined_output_dir]

    optional_dirs = [bins_dir, MAGs_dir]

    if stype == "low_biomass": expected_dirs.append(decontam_dir)
    if args.host_removed: expected_dirs.append(host_dir)
    if tech == "nanopore": expected_dirs.extend([trimmed_dir, hrrm_dir])

    if args.output == "":
        validation_log = f"{str(args.glds_id)}_{output_prefix}metagenomics-validation.log"
    else:
        validation_log = str(args.output)
        
    if args.manifest == "":
        args.default_manifest_path = f"{str(args.glds_id)}_{output_prefix}metagenomics-validation.manifest.json"
        manifest_output_file = args.default_manifest_path
    else:
        manifest_output_file = str(args.manifest)

    setup_log(validation_log, args.v_v_guidelines_link)
    
    check_expected_directories(validation_log, expected_dirs, optional_dirs)
    append_message_to_log(validation_log, "    - expected pipeline subdirectories detected")
    
    sample_names = read_samples(args.runsheet)

    # ------------------ FASTQ SEQUENCE ANALYSIS AND VALIDATION ------------------
    raw_prefix = "raw" if tech == "nanopore" else "HRrm"
    raw_multiqc_zip = Path(raw_dir, f"MultiQC_Reports/{output_prefix}{raw_prefix}_multiqc{assay_suffix}_data.zip")
    check_multiqc_outputs(validation_log, tech, sample_names, raw_multiqc_zip, raw_prefix, 
                          args.raw_R1_suffix, args.raw_R2_suffix, args.raw_suffix, args.single_ended)
    append_message_to_log(validation_log, f"    - all expected samples were found in raw multiqc files in {raw_dir}/MultiQC_Reports")
    if tech == "nanopore":
        check_nanoplot_outputs(validation_log, sample_names, Path(raw_dir, "NanoPlots"), raw_prefix, output_prefix, assay_suffix)
        append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {raw_dir}/NanoPlots")
    
    filtered_multiqc_zip = Path(filtered_dir, f"MultiQC_Reports/{output_prefix}filtered_multiqc{assay_suffix}_data.zip")
    check_multiqc_outputs(validation_log, tech, sample_names, filtered_multiqc_zip, "filtered", 
                          args.filtered_R1_suffix, args.filtered_R2_suffix, args.filtered_suffix, args.single_ended)
    append_message_to_log(validation_log, f"    - all expected samples were found in filtered multiqc files in {filtered_dir}/MultiQC_Reports")
    if tech == "nanopore":
        check_nanoplot_outputs(validation_log, sample_names, Path(filtered_dir, "NanoPlots"), "filtered", output_prefix, assay_suffix)
        append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {filtered_dir}/NanoPlots")

    if stype == "low_biomass":
        decontam_zip = Path(decontam_dir, f"MultiQC_Reports/{output_prefix}decontam_multiqc{assay_suffix}_data.zip")
        check_multiqc_outputs(validation_log, tech, sample_names, decontam_zip, "decontam", 
                              args.decontam_R1_suffix, args.decontam_R2_suffix, args.decontam_suffix, args.single_ended)
        append_message_to_log(validation_log, f"    - all expected samples were found in decontam multiqc files in {decontam_dir}/MultiQC_Reports")
        if tech == "nanopore":
            check_nanoplot_outputs(validation_log, sample_names, Path(decontam_dir, "NanoPlots"), "decontam", output_prefix, assay_suffix)
            append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {decontam_dir}/NanoPlots")
        
    if args.host_removed:
        host_zip = Path(host_dir, f"MultiQC_Reports/{output_prefix}HostRm_multiqc{assay_suffix}_data.zip")
        check_multiqc_outputs(validation_log, tech, sample_names, host_zip, "HostRm", 
                              args.host_R1_suffix, args.host_R2_suffix, args.host_suffix, args.single_ended)
        append_message_to_log(validation_log, f"    - all expected samples were found in host multiqc files in {host_dir}/MultiQC_Reports")
        if tech == "nanopore":
            check_nanoplot_outputs(validation_log, sample_names, Path(host_dir, "NanoPlots"), "HostRm", output_prefix, assay_suffix)
            append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {host_dir}/NanoPlots")
        
    if tech == "nanopore":
        trimmed_zip = Path(trimmed_dir, f"MultiQC_Reports/{output_prefix}trimmed_multiqc{assay_suffix}_data.zip")
        check_multiqc_outputs(validation_log, tech, sample_names, trimmed_zip, "trimmed", "", "", args.trimmed_suffix, True)
        append_message_to_log(validation_log, f"    - all expected samples were found in trimmed multiqc files in {trimmed_dir}/MultiQC_Reports")
        check_nanoplot_outputs(validation_log, sample_names, Path(trimmed_dir, "NanoPlots"), "trimmed", output_prefix, assay_suffix)
        append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {trimmed_dir}/NanoPlots")
        
        hrrm_zip = Path(hrrm_dir, f"MultiQC_Reports/{output_prefix}HRrm_multiqc{assay_suffix}_data.zip")
        check_multiqc_outputs(validation_log, tech, sample_names, hrrm_zip, "HRrm", "", "", args.human_suffix, True)
        append_message_to_log(validation_log, f"    - all expected samples were found in human removed multiqc files in {hrrm_dir}/MultiQC_Reports")
        check_nanoplot_outputs(validation_log, sample_names, Path(hrrm_dir, "NanoPlots"), "HRrm", output_prefix, assay_suffix)
        append_message_to_log(validation_log, f"    - all expected NanoPlot reports were found in {hrrm_dir}/NanoPlots")

    # ---------------  Fastq files validation ---------------------------------------------
    if tech == "illumina":
       check_fastq_files(validation_log, tech, sample_names, Path(filtered_dir, "Fastq/Fastp"), args.filtered_suffix, args.filtered_R1_suffix, args.filtered_R2_suffix, args.single_ended, output_prefix=output_prefix)
       append_message_to_log(validation_log, f"    - all expected fastq read files were found in {filtered_dir}/Fastq/Fastp")

    if tech == "nanopore":
        check_fastq_files(validation_log, tech, sample_names, Path(hrrm_dir, "Fastq"), args.human_suffix, output_prefix=output_prefix)
        append_message_to_log(validation_log, f"    - all expected fastq read files were found in {hrrm_dir}/Fastq")
 
    if stype == "low_biomass":
        check_fastq_files(validation_log, tech, sample_names, Path(decontam_dir, "Fastq"), args.decontam_suffix, args.decontam_R1_suffix, args.decontam_R2_suffix, args.single_ended, output_prefix=output_prefix)
        append_message_to_log(validation_log, f"    - all expected decontaminated fastq read files were found in {decontam_dir}/Fastq")

    if args.host_removed:
         check_fastq_files(validation_log, tech, sample_names, Path(host_dir, "Fastq"), args.host_suffix, args.host_R1_suffix, args.host_R2_suffix, args.single_ended, output_prefix=output_prefix)
         append_message_to_log(validation_log, f"    - all expected host removed fastq read files were found in {host_dir}/Fastq")


    # ------------------ READ-BASED PROFILING ARCHITECTURE AUDIT ------------------
    expected_read_based_outputs = [
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances-cpm{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_filtered{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Coverages/{output_prefix}Pathway-coverages-grouped-by-taxa{assay_suffix}.tsv",
        f"Humann_Outputs/Pathway_Coverages/{output_prefix}Pathway-coverages{assay_suffix}.tsv"
    ]
    if stype == "low_biomass":
        expected_read_based_outputs.extend([
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_decontam_results{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_decontam_results{assay_suffix}.tsv",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_decontam{assay_suffix}.tsv",
            f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_decontam_results{assay_suffix}.tsv"
        ])
    check_read_based_outputs(validation_log, expected_read_based_outputs, read_based_dir)
    append_message_to_log(validation_log, f"    - all expected files for read-based analysis were found in the {read_based_dir} directory")

    # HUMANN HEATMAP AUDITS
    humann_plots = [
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_filtered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_filtered_top_50_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_unfiltered_heatmap{assay_suffix}.png",
        f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_unfiltered_top_50_heatmap{assay_suffix}.png"
    ]
    if stype == "low_biomass":
        humann_plots.extend([
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-KO_decontam_top_50_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Gene_Families/{output_prefix}Gene-families-uniref_decontam_top_50_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_decontam_heatmap{assay_suffix}.png",
            f"Humann_Outputs/Pathway_Abundances/{output_prefix}Pathway-abundances_decontam_top_50_heatmap{assay_suffix}.png"
        ])
    for h_plot in humann_plots:
        check_plots_for_samples(validation_log, sample_names, Path(read_based_dir, h_plot))
    append_message_to_log(validation_log, f"    - all generated functional heatmaps contain entries for all expected samples")

    # Profilers profiling arrays
    profs = ["Kaiju", "Kraken2"]
    if tech == "illumina": profs.append("Metaphlan")
    for p in profs:
        p_dir = Path(read_based_dir, f"{p}_Outputs")
        if p == "Kraken2":
            check_for_file_and_contents(validation_log, Path(p_dir, f"MultiQC_Reports/{output_prefix}kraken2_multiqc{assay_suffix}.html"))
        check_for_file_and_contents(validation_log, Path(p_dir, f"Count_Tables/{output_prefix}{p.lower()}_filtered_species_table{assay_suffix}.tsv"))
        check_for_file_and_contents(validation_log, Path(p_dir, f"Count_Tables/{output_prefix}{p.lower()}_species_table{assay_suffix}.tsv"))
        if p == "Metaphlan":
            check_for_file_and_contents(validation_log, Path(p_dir, f"Count_Tables/{output_prefix}metaphlan-taxonomy{assay_suffix}.tsv"))
        
        # Plot verification
        check_plots_for_samples(validation_log, sample_names, Path(p_dir, f"Barplots/{output_prefix}{p.lower()}_filtered_species_barplot{assay_suffix}.html"))
        check_plots_for_samples(validation_log, sample_names, Path(p_dir, f"Barplots/{output_prefix}{p.lower()}_unfiltered_species_barplot{assay_suffix}.html"))
        check_plots_for_samples(validation_log, sample_names, Path(p_dir, f"Krona_Reports/{output_prefix}{p.lower()}-report{assay_suffix}.html"))
        
        if stype == "low_biomass":
            check_for_file_and_contents(validation_log, Path(p_dir, f"Count_Tables/{output_prefix}{p.lower()}_decontam_results{assay_suffix}.tsv"))
            check_for_file_and_contents(validation_log, Path(p_dir, f"Count_Tables/{output_prefix}{p.lower()}_decontam_species_table{assay_suffix}.tsv"))
            check_plots_for_samples(validation_log, sample_names, Path(p_dir, f"Barplots/{output_prefix}{p.lower()}_decontam_species_barplot{assay_suffix}.html"))
    append_message_to_log(validation_log, f"    - all taxonomic profiler tables and interactive barplots/Krona reports verified complete")

    # ------------------ ASSEMBLY-BASED VALIDATION MATRIX ------------------
    assembly_summary = f"{output_prefix}assembly-summaries{assay_suffix}.tsv"
    failed_assemblies = Path(assemblies_dir, f"{output_prefix}Failed-assemblies{assay_suffix}.tsv")
    failed_assemblies_list = get_failed_assemblies(failed_assemblies)

    check_assemblies(validation_log, sample_names, failed_assemblies_list, f"-assembly{assay_suffix}.fasta", assemblies_dir, assembly_summary, output_prefix)
    append_message_to_log(validation_log, f"    - all expected samples had assemblies found in {assemblies_dir}")
    
    check_genes(validation_log, sample_names, failed_assemblies_list, genes_dir, [f"-genes{assay_suffix}.faa", f"-genes{assay_suffix}.gff", f"-genes{assay_suffix}.fasta"], [f"-genes{assay_suffix}.faa", f"-genes{assay_suffix}.fasta"], output_prefix)
    append_message_to_log(validation_log, f"    - all expected predicted genes files were found in the {genes_dir} directory")
    
    check_contig_annotation(validation_log, sample_names, annotations_and_tax_dir, [f"-contig-coverage-and-tax{assay_suffix}.tsv", f"-gene-coverage-annotation-and-tax{assay_suffix}.tsv"], output_prefix)
    append_message_to_log(validation_log, f"    - all expected annotation files were found in the {annotations_and_tax_dir} directory")
    
    check_mapping(validation_log, sample_names, mapping_dir, failed_assemblies_list, [f"{assay_suffix}.bam", f"-metabat-assembly-depth{assay_suffix}.tsv"], f"-mapping-info{assay_suffix}.txt", output_prefix)
    append_message_to_log(validation_log, f"    - all expected read mapping files were found in the {mapping_dir} directory")

    expected_assembly_combined_outputs = [
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy-coverages-CPM{assay_suffix}.tsv",
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy-coverages{assay_suffix}.tsv",
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_filtered{assay_suffix}.tsv",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function-coverages-CPM{assay_suffix}.tsv",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function-coverages{assay_suffix}.tsv",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_filtered{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy-coverages-CPM{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy-coverages{assay_suffix}.tsv",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_filtered{assay_suffix}.tsv"
    ]
    if stype == "low_biomass":
        expected_assembly_combined_outputs.extend([
            f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_decontam_results{assay_suffix}.tsv",
            f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_decontam_species_table{assay_suffix}.tsv",
            f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_decontam_results{assay_suffix}.tsv",
            f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_decontam_table{assay_suffix}.tsv",
            f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_decontam_results{assay_suffix}.tsv",
            f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_decontam_species_table{assay_suffix}.tsv"
        ])
    check_combined_outputs(validation_log, combined_output_dir, expected_assembly_combined_outputs)
    append_message_to_log(validation_log, f"    - all expected cross-sample combined matrices were found in {combined_output_dir}")

    combined_plots = [
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_filtered_heatmap{assay_suffix}.png",
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_filtered_top_50_heatmap{assay_suffix}.png",
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_unfiltered_heatmap{assay_suffix}.png",
        f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_filtered_heatmap{assay_suffix}.png",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_filtered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_unfiltered_heatmap{assay_suffix}.png",
        f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_unfiltered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_filtered_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_filtered_top_50_heatmap{assay_suffix}.png",
        f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_unfiltered_heatmap{assay_suffix}.png"
    ]
    if stype == "low_biomass":
        combined_plots.extend([
            f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_decontam_heatmap{assay_suffix}.png",
            f"Contig-level/{output_prefix}Combined-contig-level-taxonomy_decontam_top_50_heatmap{assay_suffix}.png",
            f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_decontam_heatmap{assay_suffix}.png",
            f"Gene-level/KO/{output_prefix}Combined-gene-level-KO-function_decontam_top_50_heatmap{assay_suffix}.png",
            f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_decontam_heatmap{assay_suffix}.png",
            f"Gene-level/Taxonomy/{output_prefix}Combined-gene-level-taxonomy_decontam_top_50_heatmap{assay_suffix}.png"
        ])
    assembled_samples = [s for s in sample_names if s not in failed_assemblies_list]
    for c_plot in combined_plots:
        check_plots_for_samples(validation_log, assembled_samples, Path(combined_output_dir, c_plot))
    append_message_to_log(validation_log, f"    - all cross-sample combined heatmaps verified for complete sample pixel matrix inclusion")

    output_fasta_bins = [f for f in get_files_in_dir(bins_dir) if f.endswith(".zip")]
    if output_fasta_bins:
        check_bins(validation_log, bins_dir, f"{output_prefix}bins-overview{assay_suffix}.tsv", output_fasta_bins) 
        append_message_to_log(validation_log, f"    - recovered genomic bins and summaries found in {bins_dir}")
    else:
        if Path(bins_dir, f"{output_prefix}bins-overview{assay_suffix}.tsv") not in manifest_data["missing_optional"]:
            manifest_data["missing_optional"].append(str(Path(bins_dir, f"{output_prefix}bins-overview{assay_suffix}.tsv")))
        append_message_to_log(validation_log, f"    - no recovered genomic bins were found in {bins_dir}")
    
    output_fasta_mags = [f for f in get_files_in_dir(MAGs_dir) if f.endswith(".zip")]
    # If MAGs are present then check for the KEGG Decoder outputs
    KEGG_files = [Path(MAGs_dir, f"KEGG_Outputs/{output_prefix}MAG-KEGG-Decoder-out{assay_suffix}.tsv"),
                  Path(MAGs_dir, f"KEGG_Outputs/{output_prefix}MAG-KEGG-Decoder-out{assay_suffix}.html"), 
                  Path(MAGs_dir, f"KEGG_Outputs/{output_prefix}MAG-level-KO-annotations{assay_suffix}.tsv")]
    if output_fasta_mags:
        check_mags(validation_log, MAGs_dir, output_fasta_mags, output_fasta_bins, f"{output_prefix}MAGs-overview{assay_suffix}.tsv")
        for file in KEGG_files:
            check_for_file_and_contents(validation_log, file)
        append_message_to_log(validation_log, f"    - recovered meta-assembled genomes and summaries found in {MAGs_dir}")
    else:
        if Path(MAGs_dir, f"{output_prefix}MAGs-overview{assay_suffix}.tsv") not in manifest_data["missing_optional"]:
            manifest_data["missing_optional"].append(str(Path(MAGs_dir, f"{output_prefix}MAGs-overview{assay_suffix}.tsv")))
        for file in KEGG_files:
            if file not in manifest_data["missing_optional"]:
                manifest_data["missing_optional"].append(str(file))
        append_message_to_log(validation_log, f"    - no recovered meta-assembled genomes were found in {MAGs_dir}")    

    assembly_based_overview_table = Path(assembly_based_dir, f"{output_prefix}Assembly-based-processing-overview{assay_suffix}.tsv")
    check_assembly_based_overview_table(validation_log, sample_names, assembly_based_overview_table)
    append_message_to_log(validation_log, f"    - {assembly_based_overview_table} was successfully validated")

    # ------------------ RUNTIME ZIP METADATA AUDIT ------------------
    zip_archive_path = Path(args.processing_zip_file)
    runsheet = os.path.basename(args.runsheet)
    expected_zip_contents = ["command.txt","nextflow_processing_info.txt","software_versions.txt", runsheet]
    check_metagenomics_processing_zip(validation_log, zip_archive_path, expected_zip_contents)
    append_message_to_log(validation_log, f"    - processing zip file verified complete")

    # ------------------ PRINT METRIC SUMMARIES AND EXPORT MANIFEST ------------------
    write_manifest_to_disk(manifest_output_file)
    if len(manifest_data['failed_missing']) > 0:
        append_message_to_log(validation_log, "Validation failed.")
        print(f"\n{color_text('Validation failed, see manifest for list of missing files.', 'red')}")
    else:
        append_message_to_log(validation_log, "Validation completed successfully.")
        print(f"\n{color_text('Validation has completed successfully', 'green')}")
    print(f"  Manifest JSON summary written to: '{manifest_output_file}'")
    
    get_read_count_stats(validation_log, "raw", raw_multiqc_zip, tech)
    get_read_count_stats(validation_log, "filtered", filtered_multiqc_zip, tech)

if __name__ == "__main__":
    main()
