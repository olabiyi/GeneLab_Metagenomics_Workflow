#!/usr/bin/env python

"""
This is a program for generating a README.txt file for GeneLab processed metagenomics datasets.
It has been updated to follow the tree-style formatting and the specific directory structure 
provided in the dir_struct.txt file.
"""

import argparse
import datetime
import json
import sys
from pathlib import Path
from io import TextIOWrapper

# EXAMPLE USAGE
# GL-gen-processed-metagenomics-readme --output-name Post_Processing/README.txt --protocol-id GL-DPPD-7116 --runsheet PE_file.csv --technology illumina --sample-type low_biomass --assay-suffix ''  --osd-id OSD-944

parser = argparse.ArgumentParser(
    description="This program generates the corresponding README file for GeneLab processed metagenomics datasets. It is intended to \
                 be run after running `GL-validate-processed-metagenomics-data`.")

required = parser.add_argument_group('required arguments')
required.add_argument("--osd-id", help='OSDR ID (e.g. "OSD-69")', action="store", required=True)
required.add_argument("--name", required=True,
                    help='Name of individual who performed the processing')
required.add_argument("--email", required=True,
                    help='Email address of individual who performed the processing')
parser.add_argument("--output", "--output-name", default="README.txt",
                    help='Name of output file (default: "{output-prefix}README{assay-suffix}.txt")')
parser.add_argument("--protocol-id", default="GL-DPPD-7107-A",
                    help='Protocol document ID followed (default: "GL-DPPD-7107-A")')
parser.add_argument("--runsheet", default="PE_file.csv",
                    help='Runsheet file name (default: "PE_file.csv")')
parser.add_argument("--technology", default="illumina", choices=["illumina", "nanopore"],
                    help='Technology used for sequencing. (default: "illumina")')
parser.add_argument("--sample-type", default="low_biomass", choices=["low_biomass", "standard"],
                    help='Sample type sequenced. (default: "standard")')
parser.add_argument("--host-removed", default=False, action="store_true",
                    help='Indicates if host sequences were removed from the dataset (default: False)')
parser.add_argument("--output-prefix", help="Output additional file prefix if there is one", action="store", default="")
parser.add_argument("--assay-suffix", help="GeneLab assay suffix. One of: '_GLmetagenomics', '_GLlbsMetag', '_GLlblMetag', '_GLlongMetag', and \"\"", action="store", default="")
parser.add_argument("--date", action="store", default=datetime.date.today(), type=datetime.date.fromisoformat,
                    help="Date the processed data was generated in ISO format (YYYY-MM-DD). (default: today's date)")
parser.add_argument('--validation-json', action="store", help="Output json file list from GL-validate-processed-metagenomics-data script.")

if len(sys.argv) == 1:
    parser.print_help(sys.stderr)
    sys.exit(0)

args = parser.parse_args()

################################################################################

verified = []
missing_optional = []
max_offset = 0

def main():
    suffix = args.assay_suffix

    prefix = args.output_prefix
    if prefix != '' and not prefix.endswith('_'):
        prefix = f"{prefix}_"

    output_file_name = f"{prefix}README{suffix}.txt" if args.output == "README.txt" else args.output
    
    runsheet = Path(args.runsheet)

    # read validation json if present
    validation_manifest = dict()
    if args.validation_json is not None:
        validation_manifest = import_validation_manifest(Path(args.validation_json))

    with open(output_file_name, "w") as output:
        write_header(output, args.osd_id, args.name, args.email, args.protocol_id, args.date)
        write_metagenomics_body(output, runsheet, prefix, suffix, validation_manifest)


def import_validation_manifest(validation_json: Path):
    validation_manifest = dict()

    try:
        validation_manifest = json.load(open(validation_json))

        for verified_file in validation_manifest['verified']:
            verified.append(Path(verified_file).name)
        for optional_file in validation_manifest['missing_optional']:
            missing_optional.append(Path(optional_file).name)
    
    except Exception as e:
        print(f"Cannot read validation manifest ({validation_json}), proceeding without it: {e}")
        
    return validation_manifest        
        
    


################################################################################

def write_header(output, glds_id, name, email, protocol_id, date):
    # Support both GLDS and OSD prefixes
    url_base = "https://osdr.nasa.gov/bio/repo/data/studies/" if glds_id.startswith("OSD-") else "https://genelab-data.ndc.nasa.gov/genelab/accession/"
    
    header = ["################################################################################\n",
              "{:<77} {:>0}".format(f"## This directory holds processed data for NASA {glds_id}", "##\n"),
              "{:<77} {:>0}".format(f"## {url_base}{glds_id}/", "##\n"),
              "{:<77} {:>0}".format("##", "##\n"),
              "{:<77} {:>0}".format(f"## Processed by {name} ({email}) on {date}", "##\n"),
              "{:<77} {:>0}".format(f"## Based on {protocol_id}", "##\n"),
              "################################################################################\n\n",
              "Summary of contents:\n\n"]

    output.writelines(header)


def add_level_one(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int):
    lines = "   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level_two(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int, gap:int = 0):
    if gap == 1:
        lines = "       |--"
    else:
        lines = "   |   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level_three(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int, gap:int = 0):
    if gap == 2:
        lines = "   |       |--"
    else:
        lines = "   |   |   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level_four(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int, gap:int = 0):
    if gap == 2:
        lines = "   |       |   |--"
    elif gap == 3:
        lines = "   |   |       |--"
    elif gap == 23:
        lines = "   |           |--"    
    else:
        lines = "   |   |   |   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level_five(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int, gap:int = 0):
    if gap == 2:
        lines = "   |       |   |   |--"
    elif gap == 3:
        lines = "   |   |       |   |--"    
    elif gap == 4:
        lines = "   |   |   |       |--"    
    elif gap == 23:
        lines = "   |           |   |--"
    elif gap == 34:
        lines = "   |   |           |--"    
    elif gap == 234:
        lines = "   |               |--"    
    else:
        lines = "   |   |   |   |   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level_six(file_name:str, file_description:str, output_file:TextIOWrapper, max_offset:int, gap:int = 0):
    if gap == 2:
        lines = "   |       |   |   |   |--"
    elif gap == 3:
        lines = "   |   |       |   |   |--"
    elif gap == 4:
        lines = "   |   |   |       |   |--"    
    elif gap == 5:
        lines = "   |   |   |   |       |--"    
    elif gap == 23:
        lines = "   |           |   |   |--"    
    elif gap == 234:
        lines = "   |               |   |--"    
    elif gap == 34:
        lines = "   |   |           |   |--"    
    elif gap == 345:
        lines = "   |   |               |--"    
    elif gap == 35:
        lines = "   |   |       |       |--"    
    elif gap == 2345:
        lines = "   |                   |--"    
    else:
        lines = "   |   |   |   |   |   |--"
    
    spacing = max(1, max_offset - len(lines))

    if file_description == "":
        output_file.write(f"{lines} {file_name:<{spacing}}\n")
    else:
        output_file.write(f"{lines} {file_name:<{spacing}}   - {file_description}\n")

def add_level(file_name, file_description, max_offset, output, continues, is_last=False):
    indent_parts = ["   "]
    for cont in continues[:-1]:
        indent_parts.append("│   " if cont else "    ")
    
    connector = "└──" if is_last else "├──"
    indent_parts.append(connector)
    prefix = "".join(indent_parts)
    spacing = max(1, max_offset - len(prefix))

    if file_description == "":
        output.write(f"{prefix} {file_name:<{spacing}}\n")
    else:
        output.write(f"{prefix} {file_name:<{spacing}}   - {file_description}\n")

def add_spacer(output, num_lines:int = 1, gap:int = 0):
    if num_lines == 2:
        output.write("   |   |\n")
    elif num_lines == 3:
        if gap == 2:
            output.write("   |       |\n")
        else:
            output.write("   |   |   |\n")
    elif num_lines == 4:
        if gap == 3:
            output.write("   |   |       |\n")
        else:
            output.write("   |   |   |   |\n")
    elif num_lines == 5:
        if gap == 3:
            output.write("   |   |       |   |\n")
        elif gap == 34:
            output.write("   |   |           |\n")
        else:
            output.write("   |   |   |   |   |\n")
    else:
        output.write("   |\n")

