        add_level_five(humann_plots["ko_filtered"]["file"], humann_plots["ko_filtered"]["def"], output, pad, gap=4)
    if humann_plots["ko_filtered_50"]["file"] in verified:
        add_level_five(humann_plots["pathway_filtered_50"]["file"], humann_plots["pathway_filtered_50"]["def"], output, pad, gap=4)
    if is_low_biomass:
        if humann_plots["ko_decontam"]["file"] in verified:
            add_level_five(humann_plots["ko_decontam"]["file"], humann_plots["ko_decontam"]["def"], output, pad, gap=4)
        if humann_plots["ko_decontam_50"]["file"] in verified:
            add_level_five(humann_plots["ko_decontam_50"]["file"], humann_plots["ko_decontam_50"]["def"], output, pad, gap=4)
    add_spacer(output, num_lines=3)

    add_level_three("Pathway_abundances/", "Pathway abundances", output, pad)
    add_level_four(f"{prefix}Pathway-abundances-cpm{suffix}.tsv", "pathway abundances normalized to copies-per-million", output, pad)
    add_level_four(f"{prefix}Pathway-abundances-grouped-by-taxa{suffix}.tsv", "pathway abundances grouped by taxa", output, pad)
    add_level_four(f"{prefix}Pathway-abundances{suffix}.tsv", "raw pathway abundance table", output, pad)
    add_level_four("Counts_Tables/", "pathway abundances count tables", output, pad)
    if read_based_tables["humann_pathabund_filtered"]["file"] in verified:
        add_level_five(read_based_tables["humann_pathabund_filtered"]["file"], read_based_tables["humann_pathabund_filtered"]["def"], output, pad)
    if args.sample_type == "low_biomass":
        if read_based_tables["humann_pathabund_decontam_results"]["file"] in verified:
            add_level_five(read_based_tables["humann_pathabund_decontam_results"]["file"], read_based_tables["humann_pathabund_decontam_results"]["def"], output, pad)
        if read_based_tables["humann_pathabund_decontam"]["file"] in verified:
            add_level_five(read_based_tables["humann_pathabund_decontam"]["file"], read_based_tables["humann_pathabund_decontam"]["def"], output, pad)
    add_spacer(output, num_lines=4)

    add_level_four("Heatmaps/", "pathways heatmaps", output, pad)
    if humann_plots["pathway_unfiltered"]["file"] in verified:
        add_level_five(humann_plots["pathway_unfiltered"]["file"], humann_plots["pathway_unfiltered"]["def"], output, pad, gap=4)
    if humann_plots["pathway_unfiltered_50"]["file"] in verified:
        add_level_five(humann_plots["pathway_unfiltered_50"]["file"], humann_plots["pathway_unfiltered_50"]["def"], output, pad, gap=4)
    if humann_plots["pathway_filtered"]["file"] in verified:
        add_level_five(humann_plots["pathway_filtered"]["file"], humann_plots["pathway_filtered"]["def"], output, pad, gap=4)
    if humann_plots["pathway_filtered_50"]["file"] in verified:
        add_level_five(humann_plots["pathway_filtered_50"]["file"], humann_plots["pathway_filtered_50"]["def"], output, pad, gap=4)
    if is_low_biomass:
        if humann_plots["pathway_decontam"]["file"] in verified:
            add_level_five(humann_plots["pathway_decontam"]["file"], humann_plots["pathway_decontam"]["def"], output, pad, gap=4)
        if humann_plots["pathway_decontam_50"]["file"] in verified:
            add_level_five(humann_plots["pathway_decontam_50"]["file"], humann_plots["pathway_decontam_50"]["def"], output, pad, gap=4)
    add_spacer(output, num_lines=3)

    add_level_three("Pathway_coverages/", "Pathway coverages", output, pad)
    add_level_four(f"{prefix}Pathway-coverages-grouped-by-taxa{suffix}.tsv", "pathway coverages grouped by taxa", output, pad, gap=3)
    add_level_four(f"{prefix}Pathway-coverages{suffix}.tsv", "pathway coverages", output, pad, gap=3)

    add_spacer(output)

    # Processing Scripts
    add_level_one(f"processing_info{suffix}.zip", "zip archive holding info related to processing", output, pad)
    add_level_two(str(runsheet.name), "runsheet file used to run the workflow", output, pad, gap=1)
    add_level_two("command.txt", "command-line used to invoke the nextflow workflow", output, pad, gap=1)
    add_level_two("nextflow_processing_info.txt", "Nextflow log listing all commands executed by the workflow", output, pad, gap=1)
    add_level_two("software_versions.txt", "list of software versions used", output, pad, gap=1)

    output.write("\n")

if __name__ == "__main__":
    main()
